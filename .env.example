# AskMyData Server Configuration
PORT=4000
NODE_ENV=development

# Optional: Google Gemini API Key for LLM-powered natural language reasoning
# If not provided, AskMyData seamlessly operates in Built-in Offline Demo Mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (defaults to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: Supabase Integration (Live Table Ingestion & Persistent Cloud Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
